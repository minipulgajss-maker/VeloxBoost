<Window x:Class="VeloxBoost.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VeloxBoost.UI"
        Title="VeloxBoost" Width="1260" Height="800" MinWidth="1060" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0A0C16" Foreground="#EEF0FF" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolVis"/>

            <!-- Cartão de uma otimização -->
            <DataTemplate x:Key="TweakTemplate" DataType="{x:Type ui:TweakVM}">
                <Border Style="{StaticResource HoverCard}" Padding="18,14" Margin="0,0,10,8" CornerRadius="14" Opacity="{Binding Opacity}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,2,0,0" Visibility="{Binding RebootVis}" ToolTip="Restart / Reiniciar"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" ToolTip="{Binding Details}"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Padding="8,3" Margin="0,0,16,0" VerticalAlignment="Center" Background="{Binding RiskBg}">
                            <TextBlock Text="{Binding RiskText}" FontSize="10" FontWeight="Bold" Foreground="{Binding RiskFg}"/>
                        </Border>
                        <Grid Grid.Column="2" VerticalAlignment="Center" Width="96">
                            <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding IsOn, Mode=TwoWay}" Visibility="{Binding ToggleVis}"
                                      IsEnabled="{Binding Applicable}" Click="Tweak_Toggle"/>
                            <Button Style="{StaticResource GhostBtn}" Padding="14,6" HorizontalAlignment="Right" Visibility="{Binding ActionVis}"
                                    IsEnabled="{Binding Applicable}" Click="Tweak_Run" Content="{ui:Tr tw.run}"/>
                            <Border Background="#E6121630" CornerRadius="10" Visibility="{Binding Busy, Converter={StaticResource BoolVis}}">
                                <Ellipse Width="20" Height="20" StrokeThickness="2.5" Stroke="{StaticResource AccentGrad}" StrokeDashArray="5 3" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                            </Storyboard></BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- ═════════ Fundo com manchas de luz animadas ═════════ -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="Blob1" Width="620" Height="620" Canvas.Left="760" Canvas.Top="-260" Opacity="0.30">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#008B5CF6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Blob2" Width="560" Height="560" Canvas.Left="260" Canvas.Top="460" Opacity="0.20">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#22D3EE" Offset="0"/><GradientStop Color="#0022D3EE" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Blob3" Width="420" Height="420" Canvas.Left="1000" Canvas.Top="520" Opacity="0.16">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#EC4899" Offset="0"/><GradientStop Color="#00EC4899" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Border x:Name="Frame" BorderBrush="{StaticResource StrokeGrad}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═════════ Barra lateral ═════════ -->
                <Border Background="#D90D1022" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="14,16,14,14">
                        <!-- Logótipo -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,6,0,22">
                            <Grid Width="40" Height="40">
                                <Border CornerRadius="12" Background="{StaticResource AccentGrad}">
                                    <Border.Effect><DropShadowEffect x:Name="LogoGlow" Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                                </Border>
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="VeloxBoost" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentGrad3}"/>
                                <TextBlock Text="{ui:Tr app.tagline}" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Rodapé -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10" CornerRadius="12" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="UpdateBadge_Click">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="UpdDot" Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock x:Name="SideVersion" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SideUpdate" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="NavPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ═════════ Conteúdo ═════════ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de título -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                            <Border x:Name="GamePill" CornerRadius="10" Background="#1434D399" BorderBrush="#4434D399" BorderThickness="1" Padding="10,4" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="GameDot" Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GamePillText" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource Good}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                            <Button Style="{StaticResource CapBtn}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button x:Name="MaxBtn" Style="{StaticResource CapBtn}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageHost" Grid.Row="1">

                        <!-- ═════════════════ PÁGINA: INÍCIO ═════════════════ -->
                        <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="32,4,24,32">
                                <!-- Herói -->
                                <Border CornerRadius="24" MinHeight="250" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush x:Name="HeroBrush" StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6D28D9" Offset="0"/>
                                            <GradientStop Color="#4F46E5" Offset="0.45"/>
                                            <GradientStop Color="#0891B2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect><DropShadowEffect Color="#6D28D9" BlurRadius="40" ShadowDepth="0" Opacity="0.35"/></Border.Effect>
                                    <Grid>
                                        <!-- brilho decorativo -->
                                        <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-90,0" Opacity="0.25">
                                            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                                        </Ellipse>
                                        <Border CornerRadius="24" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                                        <Grid Margin="34,28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{ui:Tr dash.hello}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{ui:Tr dash.subtitle}" FontSize="14" Foreground="#DDFFFFFF" TextWrapping="Wrap" MaxWidth="520" Margin="0,6,0,18" HorizontalAlignment="Left"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                                    <RadioButton x:Name="ProfSafe" GroupName="prof" Style="{StaticResource Chip}" Checked="Profile_Checked" Tag="0">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr prof.safe}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                                                    </RadioButton>
                                                    <RadioButton x:Name="ProfBal" GroupName="prof" Style="{StaticResource Chip}" Checked="Profile_Checked" Tag="1">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr prof.balanced}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                                                    </RadioButton>
                                                    <RadioButton x:Name="ProfExt" GroupName="prof" Style="{StaticResource Chip}" Checked="Profile_Checked" Tag="2">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr prof.extreme}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                                                    </RadioButton>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="OptimizeBtn" Click="Optimize_Click" Cursor="Hand" HorizontalAlignment="Left">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="B" CornerRadius="14" Background="White" Padding="26,14" RenderTransformOrigin="0.5,0.5">
                                                                    <Border.RenderTransform><ScaleTransform x:Name="S"/></Border.RenderTransform>
                                                                    <Border.Effect><DropShadowEffect x:Name="Glow" Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard><Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" From="14" To="38" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
                                                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.35" To="0.85" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
                                                                        </Storyboard></BeginStoryboard>
                                                                    </EventTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.18"/>
                                                                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                                                            <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                                                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="B" Property="Opacity" Value="0.7"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="16" Foreground="#6D28D9"/>
                                                            <TextBlock x:Name="OptimizeText" Text="{ui:Tr dash.optimize}" FontSize="15" FontWeight="Bold" Margin="10,0,0,0" Foreground="#4C1D95"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock x:Name="ProfileDesc" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12" TextWrapping="Wrap" MaxWidth="260"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Anel de pontuação -->
                                            <Grid Grid.Column="1" Width="190" Height="190" Margin="20,0,0,0" VerticalAlignment="Center">
                                                <Ellipse Stroke="#30FFFFFF" StrokeThickness="14"/>
                                                <Path x:Name="RingPath" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.Stroke>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="White" Offset="0"/>
                                                            <GradientStop Color="#A5F3FC" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Path.Stroke>
                                                    <Path.Effect><DropShadowEffect Color="White" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/></Path.Effect>
                                                </Path>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="ScoreText" Text="0" FontSize="46" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{ui:Tr dash.score}" FontSize="12" Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Progresso -->
                                <Border x:Name="OptProgress" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
                                            <TextBlock x:Name="ProgressPct" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,0" Height="8">
                                            <Border CornerRadius="4" Background="#1EFFFFFF"/>
                                            <Border x:Name="ProgressFill" CornerRadius="4" Background="{StaticResource AccentGrad3}" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Estatísticas -->
                                <UniformGrid Columns="4" Margin="-6,16,-6,0">
                                    <Border Style="{StaticResource HoverCard}" Margin="6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Foreground="#A78BFA" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr dash.cpu}" Style="{StaticResource Caps}"/></StackPanel>
                                            <TextBlock x:Name="CpuText" Text="—" FontSize="26" FontWeight="Bold" Margin="0,8,0,10"/>
                                            <Grid Height="5"><Border CornerRadius="3" Background="#1EFFFFFF"/><Border x:Name="CpuBar" CornerRadius="3" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" Width="0"/></Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HoverCard}" Margin="6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE964;" Style="{StaticResource Icon}" Foreground="#67E8F9" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr dash.ram}" Style="{StaticResource Caps}"/></StackPanel>
                                            <TextBlock x:Name="RamText" Text="—" FontSize="26" FontWeight="Bold" Margin="0,8,0,10"/>
                                            <Grid Height="5"><Border CornerRadius="3" Background="#1EFFFFFF"/><Border x:Name="RamBar" CornerRadius="3" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" Width="0"/></Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HoverCard}" Margin="6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE701;" Style="{StaticResource Icon}" Foreground="#F472B6" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr dash.ping}" Style="{StaticResource Caps}"/></StackPanel>
                                            <TextBlock x:Name="PingText" Text="—" FontSize="26" FontWeight="Bold" Margin="0,8,0,10"/>
                                            <Grid Height="5"><Border CornerRadius="3" Background="#1EFFFFFF"/><Border x:Name="PingBar" CornerRadius="3" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" Width="0"/></Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource HoverCard}" Margin="6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="#34D399" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr dash.applied}" Style="{StaticResource Caps}"/></StackPanel>
                                            <TextBlock x:Name="AppliedText" Text="—" FontSize="26" FontWeight="Bold" Margin="0,8,0,10"/>
                                            <Grid Height="5"><Border CornerRadius="3" Background="#1EFFFFFF"/><Border x:Name="AppliedBar" CornerRadius="3" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" Width="0"/></Grid>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr dash.categories}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                        <UniformGrid x:Name="CatGrid" Columns="3" Margin="-6,0,6,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{ui:Tr dash.log}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                        <Border Style="{StaticResource Card}" Padding="16,12" MinHeight="300">
                                            <ItemsControl x:Name="LogList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,1,10,0" FontFamily="Cascadia Mono, Consolas"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═════════════════ PÁGINA: OTIMIZAÇÕES (por categoria) ═════════════════ -->
                        <Grid x:Name="PageTweaks" Margin="32,4,22,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,10,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid Width="56" Height="56">
                                    <Border CornerRadius="16" Background="{StaticResource AccentGrad}">
                                        <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                                    </Border>
                                    <TextBlock x:Name="CatGlyph" Style="{StaticResource Icon}" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CatTitle" Style="{StaticResource H1}" FontSize="26"/>
                                    <TextBlock x:Name="CatDesc" Style="{StaticResource SubT}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="CatCount" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <Grid Width="160" Height="6" Margin="0,8,0,0">
                                        <Border CornerRadius="3" Background="#1EFFFFFF"/>
                                        <Border x:Name="CatBar" CornerRadius="3" Background="{StaticResource AccentGrad3}" HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,10,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Tag="{ui:Tr tw.search}" Padding="36,0,10,0" TextChanged="Search_Changed"/>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Muted}" Margin="14,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button x:Name="BtnApplyRec" Style="{StaticResource GradBtn}" Click="ApplyRec_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock x:Name="BtnApplyRecText" Text="{ui:Tr tw.applyRec}"/></StackPanel>
                                    </Button>
                                    <Button x:Name="BtnApplyAll" Style="{StaticResource GhostBtn}" Click="ApplyAll_Click" Margin="0,0,8,0" Content="{ui:Tr tw.applyAll}"/>
                                    <Button x:Name="BtnRevertAll" Style="{StaticResource GhostBtn}" Click="RevertCat_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr tw.revertAll}"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="TweakList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                     ItemTemplate="{StaticResource TweakTemplate}" ItemContainerStyle="{StaticResource PlainItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"/>
                        </Grid>

                        <!-- ═════════════════ PÁGINA: GAME BOOSTER ═════════════════ -->
                        <ScrollViewer x:Name="PageBooster" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="32,4,24,32">
                                <TextBlock Text="{ui:Tr nav.booster}" Style="{StaticResource H1}"/>
                                <TextBlock Text="{ui:Tr boost.subtitle}" Style="{StaticResource SubT}" Margin="0,4,0,20"/>

                                <Border x:Name="BoostStatus" CornerRadius="18" Padding="22,18" Margin="0,0,0,16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2234D399" Offset="0"/>
                                            <GradientStop Color="#0822D3EE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#6634D399" Offset="0"/>
                                            <GradientStop Color="#1122D3EE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Border.BorderThickness>1</Border.BorderThickness>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                                            <Ellipse x:Name="PulseRing" Stroke="{StaticResource Good}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Good}"/>
                                        </Grid>
                                        <TextBlock x:Name="BoostStatusText" FontSize="15" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2" Margin="-6,0,-6,0">
                                    <Border Style="{StaticResource HoverCard}" Margin="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{ui:Tr boost.auto}" Style="{StaticResource H2}" FontSize="15"/>
                                                <TextBlock Text="{ui:Tr boost.auto.d}" Style="{StaticResource SubT}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="BoostAuto" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="BoostSetting_Click"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource HoverCard}" Margin="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{ui:Tr boost.bg}" Style="{StaticResource H2}" FontSize="15"/>
                                                <TextBlock Text="{ui:Tr boost.bg.d}" Style="{StaticResource SubT}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="BoostBg" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="BoostSetting_Click"/>
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr boost.games}" Style="{StaticResource H2}" FontSize="15"/>
                                        <Grid Margin="0,12,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="GameInput" Style="{StaticResource InputBox}" Tag="{ui:Tr boost.placeholder}" KeyDown="GameInput_KeyDown"/>
                                            <Button Grid.Column="1" Style="{StaticResource GradBtn}" Margin="10,0,0,0" Click="AddGame_Click">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr boost.add}"/></StackPanel>
                                            </Button>
                                        </Grid>
                                        <ItemsControl x:Name="GameList">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="9" Background="{StaticResource Input}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="10,5,4,5" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="11" Foreground="#A78BFA" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                                            <Button Style="{StaticResource CapBtn}" Width="22" Height="22" FontSize="8" Content="&#xE8BB;" Margin="4,0,0,0" Tag="{Binding}" Click="RemoveGame_Click"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{ui:Tr net.title}" Style="{StaticResource H2}" FontSize="15"/>
                                        <WrapPanel Margin="0,12,0,8">
                                            <Button Style="{StaticResource GradBtn}" Click="DnsTest_Click" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr net.test}"/></StackPanel>
                                            </Button>
                                            <Button x:Name="BestDnsBtn" Style="{StaticResource GhostBtn}" Click="BestDns_Click" Margin="0,0,8,8" Content="{ui:Tr net.bestdns}" IsEnabled="False"/>
                                            <Button Style="{StaticResource GhostBtn}" Click="ResetDns_Click" Margin="0,0,8,8" Content="{ui:Tr net.resetdns}"/>
                                            <Button Style="{StaticResource GhostBtn}" Click="FlushDns_Click" Margin="0,0,8,8" Content="{ui:Tr net.flush}"/>
                                        </WrapPanel>
                                        <ItemsControl x:Name="DnsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:DnsResultVM}">
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="130"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Ip}" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                                        <Grid Grid.Column="2" Height="6" VerticalAlignment="Center">
                                                            <Border CornerRadius="3" Background="#14FFFFFF"/>
                                                            <Border CornerRadius="3" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                                        </Grid>
                                                        <TextBlock Grid.Column="3" Text="{Binding MsText}" Margin="12,0,0,0" FontWeight="SemiBold" FontSize="12"/>
                                                        <Border Grid.Column="4" Visibility="{Binding BestVis}" HorizontalAlignment="Left" CornerRadius="6" Background="#2234D399" Padding="7,2" Margin="10,0,0,0">
                                                            <TextBlock Text="★" Foreground="{StaticResource Good}" FontSize="11"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═════════════════ PÁGINA: BACKUP ═════════════════ -->
                        <ScrollViewer x:Name="PageBackup" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="32,4,24,32">
                                <TextBlock Text="{ui:Tr nav.backup}" Style="{StaticResource H1}"/>
                                <TextBlock Text="{ui:Tr bk.subtitle}" Style="{StaticResource SubT}" Margin="0,4,0,20"/>
                                <Border Style="{StaticResource Card}" Padding="26">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Width="70" Height="70">
                                            <Border CornerRadius="20" Background="{StaticResource AccentGrad}"/>
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="30" Foreground="White" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="BackupCount" FontSize="22" FontWeight="Bold"/>
                                            <TextBlock x:Name="BackupPath" Style="{StaticResource SubT}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Style="{StaticResource GradBtn}" Click="RestorePoint_Click" Margin="0,0,10,10">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr bk.restorepoint}"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostBtn}" Click="RevertEverything_Click" Margin="0,0,10,10">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr bk.revertall}"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostBtn}" Click="OpenData_Click" Margin="0,0,10,10">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr bk.openfolder}"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostBtn}" Click="Rstrui_Click" Margin="0,0,10,10">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{ui:Tr bk.rstrui}"/></StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═════════════════ PÁGINA: DEFINIÇÕES ═════════════════ -->
                        <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="32,4,24,32" MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock Text="{ui:Tr nav.settings}" Style="{StaticResource H1}" Margin="0,0,0,20"/>

                                <TextBlock Text="{ui:Tr set.language}" Style="{StaticResource Caps}" Margin="4,0,0,8"/>
                                <WrapPanel x:Name="LangPanel" Margin="0,0,0,22"/>

                                <TextBlock Text="{ui:Tr set.general}" Style="{StaticResource Caps}" Margin="4,0,0,8"/>
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <StackPanel x:Name="SettingsRows"/>
                                </Border>

                                <TextBlock Text="{ui:Tr set.updsection}" Style="{StaticResource Caps}" Margin="4,22,0,8"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid Width="46" Height="46">
                                                <Border CornerRadius="14" Background="{StaticResource AccentGrad}"/>
                                                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource SubT}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="CheckUpdBtn" Style="{StaticResource GhostBtn}" Click="CheckUpdate_Click" Content="{ui:Tr set.check}" Margin="0,0,8,0"/>
                                                <Button x:Name="InstallUpdBtn" Style="{StaticResource GradBtn}" Click="InstallUpdate_Click" Content="{ui:Tr set.upd.install}" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid x:Name="UpdProgress" Height="6" Margin="0,14,0,0" Visibility="Collapsed">
                                            <Border CornerRadius="3" Background="#1EFFFFFF"/>
                                            <Border x:Name="UpdFill" CornerRadius="3" Background="{StaticResource AccentGrad3}" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                        <TextBlock Text="{ui:Tr set.upd.source}" Style="{StaticResource Caps}" Margin="0,18,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="UpdateSourceBox" Style="{StaticResource InputBox}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                            <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Margin="8,0,0,0" Click="SaveSource_Click" Content="OK"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="#0E1126">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Good}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                                        <TextBlock Text="{ui:Tr set.about}" Style="{StaticResource SubT}" MaxWidth="780"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ═════════ Toast ═════════ -->
        <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" CornerRadius="14"
                Background="#F2171C3D" BorderBrush="{StaticResource HoverStroke}" BorderThickness="1" Padding="18,12" Opacity="0" IsHitTestVisible="False" MaxWidth="460">
            <Border.RenderTransform><TranslateTransform x:Name="ToastShift" Y="30"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#000000"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Grid Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse Fill="{StaticResource AccentGrad}"/>
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
